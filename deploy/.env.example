# Arcane project environment for deploy/docker-compose.yml. Copy, fill in, paste into the Arcane project's .env.

# Image tag from GHCR. Prefer a pinned one (sha-<7 chars> or a release like 1.2.3) so a redeploy never changes by surprise.
# `latest` follows master.
HOMEROOM_TAG=latest

# REQUIRED. The address speakers, Home Assistant and the TVs use to reach this service. No trailing slash.
PUBLIC_BASE_URL=http://192.168.1.10:8080

# Recommended: guards every mutating API call and the GET hook URLs (enter it in the dashboard's "Admin token" field).
ADMIN_TOKEN=

TZ=America/Toronto
HOMEROOM_PORT=8080
# Bind to one interface instead of all (e.g. the NAS LAN address).
HOMEROOM_PUBLISH_ADDR=0.0.0.0
HOMEROOM_ALLOWED_ORIGINS=
LOG_LEVEL=warn

# Host paths (created and chowned to 1000:1000 once, see docs/DEPLOYMENT.md).
HOMEROOM_DATA_DIR=/mnt/apps/homeroom/data
HOMEROOM_MEDIA_DIR=/mnt/apps/homeroom/media
