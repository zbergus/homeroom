{
  "name": "homeroom-server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "sim": "tsx src/sim/run.ts",
    "lint": "cd .. && server/node_modules/.bin/biome lint"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.7",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
