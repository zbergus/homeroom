TZ=America/Toronto
PORT=8080
# REQUIRED for goal horns: the address speakers/Home Assistant can reach, no trailing slash
PUBLIC_BASE_URL=http://192.168.1.10:8080
PUSHER_APP_KEY=homeroom-local-key
PUSHER_APP_SECRET=change-me
ADMIN_TOKEN=
HOMEROOM_API_KEY=
# Optional: browser origins besides this server that may call the API (host[:port], comma separated), e.g. a Vite dev server
HOMEROOM_ALLOWED_ORIGINS=
# Recommended on anything but a closed LAN: only this key may link a Home Assistant install
# HOMEROOM_API_KEY=
